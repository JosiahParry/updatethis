#!/bin/sh
#
# Validate and enhance the commit message with git-sv.
#
# Enable with:
#     git config core.hooksPath .githooks

if ! command -v git-sv >/dev/null 2>&1; then
    cat >&2 <<'EOF'
git-sv not found.

Install it from https://github.com/thegeeklab/git-sv, or skip this hook with:

    git commit --no-verify
EOF
    exit 1
fi

# --log-level error suppresses the "could not find issue id" warning that
# git-sv emits for branches without a ticket ID in the name.
git sv --log-level error validate-commit-message \
    --path "$(git rev-parse --show-toplevel)" \
    --file "$1" \
    --source "$2"
